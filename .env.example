# Copy to .env and adjust. Every value has a safe default for local development.

# --- Safety guard (brief, Section 2.1). Keep true unless you have explicit authorisation
# to interact with the target. Built-in collectors are all passive anyway.
PASSIVE_ONLY=true

# --- Neo4j (docker compose and the native install script both use NEO4J_PASSWORD)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=osintree-dev
NEO4J_DATABASE=neo4j

# --- How `make up` starts Neo4j: docker (default) or native (systemd service)
NEO4J_MODE=docker

# --- API server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Collectors: on-disk response cache and HTTP settings
CACHE_DIR=.cache
HTTP_TIMEOUT=20

# --- Localisation: UI default and report default (en | pt)
DEFAULT_LOCALE=en
REPORT_LOCALE=pt
